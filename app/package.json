{
  "name": "mapa-setas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "datos": "node scripts/enlazar-datos.mjs public && node scripts/enlazar-guia.mjs && node scripts/enlazar-ort.mjs",
    "dev": "npm run datos && vite",
    "build": "node scripts/enlazar-guia.mjs && node scripts/enlazar-ort.mjs && tsc --noEmit && vite build && node scripts/enlazar-datos.mjs dist",
    "servir": "php -S 127.0.0.1:8765 -t dist servidor.php",
    "test": "vitest run",
    "aviso": "node scripts/aviso-ventanas.mts",
    "e2e": "node e2e/offline.e2e.mjs && node e2e/regiones.e2e.mjs && node e2e/citas-hoy.e2e.mjs && node e2e/disposicion.e2e.mjs && node e2e/campo.e2e.mjs && node e2e/campo-micro.e2e.mjs && node e2e/por-sitio.e2e.mjs",
    "e2e:disposicion": "node e2e/disposicion.e2e.mjs",
    "e2e:campo": "node e2e/campo.e2e.mjs && node e2e/campo-micro.e2e.mjs",
    "e2e:citas": "node e2e/citas-hoy.e2e.mjs",
    "e2e:por-sitio": "node e2e/por-sitio.e2e.mjs",
    "e2e:gemini-real": "node e2e/gemini-real.red.mjs",
    "e2e:marbella": "node e2e/offline.e2e.mjs",
    "e2e:regiones": "node e2e/regiones.e2e.mjs",
    "cobertura": "vitest run --coverage --coverage.include=src/seguridad.ts --coverage.include=src/reconocer-nucleo.ts --coverage.thresholds.100"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@protomaps/basemaps": "5.7.2",
    "idb-keyval": "6.3.0",
    "maplibre-gl": "6.14.0",
    "onnxruntime-web": "1.20.1",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}

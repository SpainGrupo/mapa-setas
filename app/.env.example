# Variables de build (Vite). Copia a .env (no secretas: van en el HTML/JS publicado).
# Worker de Cloudflare (Gemini y chat); publicar.sh pone el de producción si no se define.
VITE_WORKER_URL=
# Id de proyecto de Microsoft Clarity. Vacío = sin aviso de cookies y sin Clarity.
# El de producción (za3tx4jkja) está en app/.env, que recogen npm run build y scripts/publicar.sh.
VITE_CLARITY_ID=
